# ==================================================
# ADVENTURE RECORDS — PRODUCTION ENVIRONMENT TEMPLATE
# Copy to .env and configure secrets securely. NEVER commit .env to version control.
# ==================================================

# ── 1. Frontend Firebase Client Configuration ──
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=music-b2696.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=music-b2696
VITE_FIREBASE_STORAGE_BUCKET=music-b2696.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# ── 2. Frontend Backend API URL ──
# Local dev: http://localhost:5000 | Production: https://your-backend-api.onrender.com
VITE_API_URL=http://localhost:5000

# ── 3. Node.js Express Server Configuration ──
PORT=5000
NODE_ENV=production
JWT_SECRET=your_strong_random_jwt_secret_min_64_chars_here
ALLOWED_ORIGINS=http://localhost:5173,https://music-b2696.web.app,https://music-b2696.firebaseapp.com

# ── 4. MongoDB Database (Optional — defaults to Local JSON Database if empty) ──
MONGODB_URI=

# ── 5. Server-Side SMTP Email Configuration (Nodemailer) ──
EMAIL_SERVICE=gmail
EMAIL_USER=adventureof693@gmail.com
EMAIL_PASS=your_gmail_app_password_here
ADMIN_EMAIL=adventureof693@gmail.com
ADMIN_PANEL_URL=https://music-b2696.web.app/admin

# ── 6. Automated Payment Gateway Webhook (Optional — for Cashfree / Razorpay) ──
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here
