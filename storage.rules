rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User Audio WAV/FLAC Files
    match /audio/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User Release Artwork Images
    match /artwork/{userId}/{allPaths=**} {
      allow read: if true; // Public artwork display for store ingestion
      allow write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
